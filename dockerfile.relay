# Optional web deployment with a same-origin, server-side WebSocket relay.

FROM node:22-alpine AS relay-dependencies

WORKDIR /opt/stapxs-relay
COPY server/websocket-relay/package*.json ./
RUN npm ci --omit=dev

FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*
COPY dist /usr/share/nginx/html
RUN sed -i 's#</head>#<meta name="stapxs-ws-relay" content="enabled"></head>#' \
    /usr/share/nginx/html/index.html

COPY --from=relay-dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=relay-dependencies /opt/stapxs-relay/node_modules /opt/stapxs-relay/node_modules
COPY server/websocket-relay/index.mjs /opt/stapxs-relay/index.mjs
COPY server/websocket-relay/nginx.conf /etc/nginx/conf.d/default.conf
COPY server/websocket-relay/start.sh /opt/stapxs-relay/start.sh
RUN chmod +x /opt/stapxs-relay/start.sh

ENV SSQQ_ENABLE_WS_RELAY=true
ENV SSQQ_WS_RELAY_PRIVATE_ONLY=true
ENV SSQQ_WS_RELAY_LOOPBACK_HOST=host.docker.internal

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:8080/_stapxs/health > /dev/null || exit 1

CMD ["/opt/stapxs-relay/start.sh"]
